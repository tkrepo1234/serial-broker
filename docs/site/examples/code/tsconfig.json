{
  // The documentation's example code, type-checked against the library's source so an example
  // cannot silently fall out of step with the API it demonstrates (docs/guidelines/documentation.md).
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "serial-broker": ["../../../../src/index.ts"],
      "serial-broker/diagnostics": ["../../../../src/diagnostics.ts"]
    }
  },
  "include": ["./**/*.ts"]
}
