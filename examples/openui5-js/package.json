{
  "name": "serial-broker-openui5-js-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classic SAPUI5 application in JavaScript (sap.ui.define, no transpile) using serial-broker.",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/copy-serial-broker-assets.mjs",
    "start": "ui5 serve --port 8160",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/copy-serial-broker-assets.mjs",
    "build": "ui5 build --clean-dest"
  },
  "dependencies": {
    "serial-broker": "file:../.."
  },
  "devDependencies": {
    "@openui5/types": "1.148.8",
    "@ui5/cli": "^4.0.67",
    "typescript": "^6.0.3",
    "ui5-tooling-modules": "^3.38.3"
  },
  "allowScripts": {
    "ui5-tooling-modules": false
  }
}
