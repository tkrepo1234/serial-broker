{
  "name": "serial-broker",
  "version": "0.1.0",
  "description": "Cross-tab Web Serial access for Chromium: one shared port, every tab, automatic reconnect and failover.",
  "keywords": [
    "web-serial",
    "serial",
    "sharedworker",
    "cross-tab",
    "chromium",
    "web-locks",
    "rs232",
    "usb-serial"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "require": "./dist/diagnostics.cjs"
    },
    "./debug/*": "./dist/debug/*",
    "./worker": "./dist/serial-broker.worker.js",
    "./serial-broker.worker.js": "./dist/serial-broker.worker.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.debug.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p emulator && tsc -p docs/site/examples/code",
    "emulator": "node emulator/src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "docs": "node docs/site/build.mjs",
    "debug": "npm run build && npx --yes serve dist",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "unrs-resolver@1.12.2": true
  }
}
